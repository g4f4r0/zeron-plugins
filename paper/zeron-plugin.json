{
  "id": "paper",
  "name": "Paper",
  "version": "0.3.0",
  "icon": "icon.svg",
  "description": "Paper designs for every agent, live on the chat's panel.",
  "entry": "init.luau",
  "service": "service.luau",
  "permissions": [
    "tools",
    "service",
    "network",
    "ui.add",
    "panel.tabs",
    "web",
    "sessions.read",
    "files.read",
    "commands",
    "links.open"
  ],
  "commands": [
    "cat",
    "tee",
    "openssl"
  ],
  "network": {
    "hosts": [
      "mcp.paper.design",
      "login.paper.design"
    ]
  },
  "tools": [
    {
      "name": "list_tools",
      "description": "List Paper's design tools (MCP tools/list from Paper's server) with their input schemas and Paper's instructions. Call once before using Paper. A project's Paper files are linked in paper.json at its root.",
      "input": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "call_tool",
      "description": "Call one of Paper's tools by name (tools/call). Arguments go to Paper unchanged; Paper's result comes back unchanged.",
      "input": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "A tool name from list_tools."
          },
          "arguments": {
            "type": "object",
            "description": "That tool's arguments, as its input schema says."
          }
        },
        "required": [
          "name"
        ]
      }
    }
  ],
